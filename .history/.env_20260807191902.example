# ============================================
# LETCON - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ---------- App Configuration ----------
VITE_APP_NAME=LETCON
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# ---------- Firebase Configuration ----------
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ---------- Paystack Configuration ----------
# Get these from: https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
# Server-side secret key (used by Cloud Functions - NEVER expose in frontend)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# ---------- Cloudinary (Optional - for media optimization) ----------
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ---------- Email API (Optional - for transactional emails) ----------
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=no-reply@letcon.app

# ---------- OpenAI API (Future use - AI features) ----------
OPENAI_API_KEY=your-openai-api-key

# ---------- Firebase Admin (Cloud Functions) ----------
# Path to your Firebase Admin SDK service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ---------- FCM (Firebase Cloud Messaging) ----------
VITE_FCM_VAPID_KEY=your-fcm-vapid-key